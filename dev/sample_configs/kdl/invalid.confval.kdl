hostname "0.0.0.0"
port 99999
workers 9999
tls #true
oops "not a known field"
limits {
  max_body_mb 5000
  mode "loud"
}
upstream "api" {
  host "api.internal"
  port 8080
}
rules {
  prefix "/api"
  upstream "nope"
}
service {
  name "checkout"
  endpoints "primary" {
    port 9000
  }
  routes {
    prefix "/pay"
    endpoint "backup"
  }
}
service {
  name "billing"
  endpoints "backup" {
    port 9100
  }
  endpoints "backup" {
    port 9101
  }
}
